# shopsite-starter environment template
#
# Copy this file and fill in your own values. Never commit the copy:
#   cp .env.example .env.local
#
# Placeholders below are fake. Replace every value before running the app.
# Buyers must set real production Stripe keys and STRIPE_WEBHOOK_SECRET
# before going live. Do not commit .env, .env.local, or any live secrets.

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# Server-only shared secret for admin routes and privileged server actions.
# Use at least 32 random characters (for example: openssl rand -base64 32).
# Never prefix this with NEXT_PUBLIC_ — it must not reach the browser.
ADMIN_SECRET=replace_with_at_least_32_random_characters

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# The only Stripe value that belongs in the client. Publishable key from
# the Stripe Dashboard (pk_test_... locally, pk_live_... in production).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Server-only. Secret key from the Stripe Dashboard.
# Use sk_test_... locally and sk_live_... in production. Never NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Server-only signing secret for the Stripe webhook endpoint.
# Required in production. From the Dashboard webhook endpoint, or from
# `stripe listen` while developing (whsec_...). Never NEXT_PUBLIC_.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# -----------------------------------------------------------------------------
# PayPal (optional)
# -----------------------------------------------------------------------------
# Stripe Checkout stays available either way. Leave these placeholders in
# place to hide PayPal. The bag shows PayPal Buttons only when PAYPAL_MODE
# and that mode's client id, secret, and webhook id are real, and the
# public client id equals that mode's client id.
#
# Sandbox and live are separate values. The server uses only the trio for
# PAYPAL_MODE, so a sandbox client id is never paired with the live secret.
# Set both trios only when they are different apps. Switch PAYPAL_MODE from
# sandbox to live, and set NEXT_PUBLIC_PAYPAL_CLIENT_ID to the live client
# id, when you go live. Rebuild after changing NEXT_PUBLIC_ values.
#
# The client id below is the only PayPal value that may use NEXT_PUBLIC_.
# Secrets and webhook ids are server-only. Never prefix them with NEXT_PUBLIC_.
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_SANDBOX_CLIENT_ID=your_sandbox_client_id
PAYPAL_SANDBOX_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_SANDBOX_WEBHOOK_ID=your_sandbox_webhook_id
PAYPAL_LIVE_CLIENT_ID=your_live_client_id
PAYPAL_LIVE_CLIENT_SECRET=your_live_client_secret
PAYPAL_LIVE_WEBHOOK_ID=your_live_webhook_id

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Required in production (NODE_ENV=production): a real Postgres URL.
# Missing or the placeholder below refuses boot — no in-memory stock or
# session store. Local development: a placeholder or empty value may use
# the kit’s local fallback. Still replace this before any real deploy.
# Server-only. Never NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public site origin for canonical URLs, Checkout return URLs, and webhooks.
# Required in production. No trailing slash. Set this to the real https origin
# before a Vercel production build. The production build fails when it is
# missing or a local-only host (localhost, 127.0.0.1, and similar).
# Vercel preview builds can omit it and use https://$VERCEL_URL.
# Local development: http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only crawler switch. Not a secret. Do not prefix with NEXT_PUBLIC_.
# AI crawlers in /robots.txt: GPTBot, Google-Extended, PerplexityBot, ClaudeBot, and Bingbot.
# Safe default: 1 (or unset) allows them on public pages.
# /admin, /api, /success, and /cancel stay disallowed for every user agent.
# Set to 0 to disallow those crawlers. By default that includes Bingbot.
# Rebuild after changing this.
GEO_ALLOW_AI_CRAWLERS=1

# Optional server-only switch. Not a secret. Do not prefix with NEXT_PUBLIC_.
# Unset by default. Anything other than 1 leaves Bingbot on the GEO_ALLOW_AI_CRAWLERS rule.
# Set to 1 to keep Bingbot allowed on public pages when GEO_ALLOW_AI_CRAWLERS=0
# (normal Bing search). The other AI crawlers stay disallowed.
# /admin, /api, /success, and /cancel stay disallowed for every user agent.
# Rebuild after changing this.
# GEO_KEEP_BINGBOT=1
