# shopsite-starter
# Ignore local secrets, build output, and machine-specific files.
# .env.example is the only environment file that belongs in git.

# -----------------------------------------------------------------------------
# Secrets and environment
# Never commit real .env files. Buyers copy .env.example to .env.local.
# -----------------------------------------------------------------------------
.env
.env.*
.env.local
.env.*.local
!.env.example

# Private keys and credential material
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa
id_rsa.pub
*.keystore
credentials.json
*-credentials.json
service-account*.json

# -----------------------------------------------------------------------------
# Dependencies and package managers
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# -----------------------------------------------------------------------------
# Next.js, build output, and caches
# -----------------------------------------------------------------------------
.next/
out/
dist/
build/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

# -----------------------------------------------------------------------------
# Logs and coverage
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
coverage/
.nyc_output/
*.lcov

# -----------------------------------------------------------------------------
# Stripe CLI
# User-level CLI config lives outside the repo (~/.config/stripe).
# Ignore any project-local CLI state (login cache, listen fixtures).
# -----------------------------------------------------------------------------
.stripe/

# -----------------------------------------------------------------------------
# OS junk
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Editors and IDEs
# Buyer kit: keep personal IDE settings out of the repo.
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
